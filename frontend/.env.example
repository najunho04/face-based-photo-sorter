# 복사해서 frontend/.env.development.local 로 사용 (개발 서버에서만 적용, 저장소에 안 올라감)
# 브라우저에 그대로 노출되므로 비밀값은 넣지 말 것. Vite 기준이라 VITE_ 접두사 필요

# 백엔드 API 주소. 비워 두면 화면과 같은 주소의 /api 로 요청한다
# - 로컬 개발: 비워 둠 → 개발 서버가 /api 를 아래 VITE_API_PROXY_TARGET 으로 넘김(백엔드 CORS 불필요)
# - 배포: 배포 방식(인프라와 결정 중)에 따라 API 도메인을 넣거나 비워 둠
VITE_API_BASE_URL=

# 개발 서버가 /api 요청을 넘길 로컬 백엔드 주소
VITE_API_PROXY_TARGET=http://localhost:8000

# false면 위 주소의 실제 백엔드 사용. 비워 두면 개발 서버(npm run dev)는 MSW 가짜 API
# 빌드 결과(npm run build)는 이 값과 상관없이 항상 실제 API
VITE_USE_MOCK=false
