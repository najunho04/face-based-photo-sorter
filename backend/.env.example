# 복사해서 backend/.env로 사용 (backend/에서 cp .env.example .env). .env는 커밋하지 않음
# backend/docker-compose.yml의 database 서비스도 이 파일을 읽으므로 DB 값은 한 곳에서만 관리

# --- DB ---
POSTGRES_DB=photo_sorter
POSTGRES_USER=photo_sorter
POSTGRES_PASSWORD=photo_sorter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- NAS: 로컬은 backend/nas, 운영은 서버에 마운트된 /nas ---
NAS_ROOT_PATH=./nas

# --- 분류 스케줄러: API 서버가 몇 초마다 멈춘 사진 복구 + 추출 끝난 행사 분류·보관 (false면 끔) ---
CLUSTERING_SCHEDULER_ENABLED=true

# --- 인증: 관리자 계정은 데모용으로 1개 고정 ---
JWT_SECRET_KEY=change-me
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me
# 관리자·참가자 토큰 만료(초). 12시간
ACCESS_TOKEN_EXPIRATION_SECONDS=43200

# --- NCP Object Storage (S3 호환). 키는 인프라 담당에게 받기 ---
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PRESIGNED_URL_EXPIRATION_SECONDS=3600
